# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# PyInstaller build outputs (the *.spec files themselves stay tracked)
build/
dist/
*.manifest
warn-*.txt
xref-*.html

# Logs (crash/error logs contain local paths)
*.log

# Test / tool caches
.pytest_cache/
.mypy_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local password hash (created by set_password.py) - never commit
app/config/password_local.py
